# PeçaAki Slz — Configurações de Ambiente (Supabase PostgreSQL & Auth)
# Substitua [YOUR-PASSWORD] pela senha do banco de dados configurada no Supabase

# URL do Connection Pooler do Supabase (para Vercel / Serverless - porta 6543)
DATABASE_URL="postgresql://postgres.sujflwdlgcskqdjblspr:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL de Conexão Direta do Supabase (para migrations do Prisma - porta 5432)
DIRECT_URL="postgresql://postgres.sujflwdlgcskqdjblspr:[YOUR-PASSWORD]@db.sujflwdlgcskqdjblspr.supabase.co:5432/postgres"

# Segredo de Assinatura dos Tokens JWT
JWT_SECRET="pecaaki_secret_key_slz_2026_prod"

# Supabase Auth — recuperação e sincronização de senha
# A chave service role/secret é exclusivamente server-side; nunca use NEXT_PUBLIC_ para ela.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Alternativa para projetos que usam a nomenclatura nova do Supabase.
SUPABASE_SECRET_KEY="sb_secret_..."
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Compatibilidade com projetos que ainda usam a nomenclatura anon.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
